{
  "name": "audit-service",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight Audit worker service for DashRoute",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --import ./src/instrumentation.ts src/main.ts",
    "build": "tsc",
    "start": "node --import ./dist/instrumentation.js dist/main.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:cov": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "amqplib": "^0.10.5",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@dashroute/eslint-config": "workspace:*",
    "@dashroute/prettier-config": "workspace:*",
    "@dashroute/ts-config": "workspace:*",
    "@types/amqplib": "^0.10.6",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
