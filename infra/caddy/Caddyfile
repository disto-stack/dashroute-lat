{
}

http://api.dashroute.localhost, http://:80 {
	rate_limit {
		zone default {
			key {remote_ip}
			events 100
			window 1m
		}
	}

	@cors_preflight method OPTIONS
	handle @cors_preflight {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "Accept, Content-Type, Authorization, X-Requested-With"
		header Access-Control-Max-Age "3600"
		respond 204
	}

	header Access-Control-Allow-Origin "*"
	header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
	header Access-Control-Allow-Headers "Accept, Content-Type, Authorization, X-Requested-With"

	handle_path /api/v1/* {
		@auth path /auth /auth/*
		handle @auth {
			reverse_proxy host.docker.internal:4001 {
				header_down -Access-Control-Allow-Origin
				header_down -Access-Control-Allow-Methods
				header_down -Access-Control-Allow-Headers
			}
		}

		@orders path /orders /orders/*
		handle @orders {
			reverse_proxy host.docker.internal:4002 {
				header_down -Access-Control-Allow-Origin
				header_down -Access-Control-Allow-Methods
				header_down -Access-Control-Allow-Headers
			}
		}

		@geo path /geo /geo/* /geolocation /geolocation/*
		handle @geo {
			uri strip_prefix /geolocation
			uri strip_prefix /geo
			reverse_proxy host.docker.internal:4003 {
				header_down -Access-Control-Allow-Origin
				header_down -Access-Control-Allow-Methods
				header_down -Access-Control-Allow-Headers
			}
		}
		
		@notifications path /devices /devices/* /notifications /notifications/*
		handle @notifications {
			uri strip_prefix /notifications
			reverse_proxy host.docker.internal:4004 {
				header_down -Access-Control-Allow-Origin
				header_down -Access-Control-Allow-Methods
				header_down -Access-Control-Allow-Headers
			}
		}
	}

	handle {
		respond "DashRoute API Gateway is running!" 200
	}
}
