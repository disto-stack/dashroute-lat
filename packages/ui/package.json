{
  "name": "@dashroute/ui",
  "version": "0.0.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./.storybook-native": "./.storybook-native/index.tsx"
  },
  "scripts": {
    "storybook:web": "storybook dev -p 6006 -c .storybook-web",
    "build-storybook:web": "storybook build -c .storybook-web -o storybook-static",
    "storybook:native": "echo 'Native Storybook runs through the Expo/Metro runtime — see: pnpm --filter dashroute-mobile-driver storybook'",
    "test": "vitest run --project=storybook",
    "test:watch": "vitest --project=storybook",
    "test:native": "jest"
  },
  "dependencies": {
    "@dashroute/ui-tokens": "workspace:*",
    "@rn-primitives/hooks": "^1.0.0",
    "@rn-primitives/portal": "^1.0.0",
    "@rn-primitives/slot": "^1.0.0",
    "@rn-primitives/types": "^1.0.0",
    "expo-haptics": "^57.0.3",
    "lucide-react": "^1.47.0",
    "lucide-react-native": "^1.47.0",
    "react-native-svg": "^15.11.1"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/react-native": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "expo": "~57.0.24",
    "jest": "^29.7.0",
    "jest-expo": "57.0.5",
    "playwright": "^1.63.0",
    "react-native": "0.86.3",
    "react-test-renderer": "19.2.3",
    "storybook": "^10.6.0",
    "vite": "^7",
    "vitest": "^4.1.11"
  }
