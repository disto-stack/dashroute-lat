{
  "name": "dashroute-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "DashRoute - Distributed logistics and auto-dispatch engine",
  "scripts": {
    "build": "pnpm -r --filter=!./services/dispatch-engine build",
    "test": "pnpm -r --filter=!./services/dispatch-engine test",
    "lint": "pnpm -r --filter=!./services/dispatch-engine lint",
    "lint:fix": "pnpm -r --filter=!./services/dispatch-engine lint:fix",
    "format": "prettier --write \"**/*.{ts,js,json,yaml,yml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,yaml,yml,md}\"",
    "dev:auth": "pnpm --filter auth-service dev",
    "dev:orders": "pnpm --filter orders-service dev",
    "dev:audit": "pnpm --filter audit-service dev",
    "dev:services": "concurrently -k -n \"AUTH,ORDERS,AUDIT\" -c \"cyan,yellow,magenta\" \"pnpm dev:auth\" \"pnpm dev:orders\" \"pnpm dev:audit\""
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "typescript": "^5.8.3"
    }
  },
  "devDependencies": {
    "@dashroute/prettier-config": "workspace:*",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/instrumentation-pino": "^0.68.0"
  }
}
